@inherits LayoutComponentBase
@using System.Reflection

<RadzenComponents />

<div class="po-shell">
    <header class="po-header">
        <div class="po-header__brand">
            <span class="po-logo">R1</span>
            <div>
                <div class="po-title">PoRobotTrain</div>
                <div class="po-subtitle">Unitree R1 Stand Explore · Blazor WASM + .NET API</div>
            </div>
        </div>
        <nav class="po-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="po-nav__link">Control &amp; 26-DOF</NavLink>
            <NavLink href="/diag" class="po-nav__link">Diagnostics</NavLink>
            <a href="/scalar" target="_blank" class="po-nav__link">OpenAPI</a>
        </nav>
        <span class="po-stamp">v@(BuildStamp)</span>
    </header>

    <main class="po-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="po-card po-card--danger">
                    <h2>UI Error</h2>
                    <p>@ex.Message</p>
                    <button type="button" class="po-btn" @onclick="Recover">Recover</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private static readonly string BuildStamp = typeof(MainLayout).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value ?? "dev";

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();
}
