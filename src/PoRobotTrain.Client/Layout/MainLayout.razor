@inherits LayoutComponentBase
@implements IDisposable
@using System.Reflection
@inject UiState Ui
@inject NavigationManager Nav

<RadzenComponents />

<div class="po-shell">
    <header class="po-header">
        <div class="po-header__brand">
            <span class="po-logo">R1</span>
            <div>
                <div class="po-title">PoRobotTrain</div>
                <div class="po-subtitle">Unitree R1 on its stand · twin first, robot second</div>
            </div>
        </div>
        @* Five places only; Robustness and Diagnostics live under Health, OpenAPI in Help (simplification #5). *@
        <nav class="po-nav" aria-label="Main">
            <NavLink href="/" Match="NavLinkMatch.All" class="po-nav__link">Control</NavLink>
            <NavLink href="/motions" class="po-nav__link">Motions</NavLink>
            <NavLink href="/walk" class="po-nav__link">Walk</NavLink>
            <NavLink href="/robot-health" class="@HealthLinkClass">Health</NavLink>
            <NavLink href="/setup" class="po-nav__link">Setup</NavLink>
            <HelpDrawer />
        </nav>
        <div class="po-header__right">
            <RobotBadge />
            <label class="adv-toggle" title="Show expert tools: modes, limits, calibration, network, versions, the 26-joint matrix and raw logs">
                <RadzenCheckBox TValue="bool" Value="@Ui.Advanced" Change="@(v => Ui.SetAdvancedAsync(v))" /> Advanced
            </label>
            <EstopButton />
        </div>
    </header>

    @if (!IsControlPage)
    {
        <AskBar />
    }

    <main class="po-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="po-card po-card--danger">
                    <h2>UI Error</h2>
                    <p>@ex.Message</p>
                    <RadzenButton class="po-plain po-btn" Click="Recover">Recover</RadzenButton>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    @* Version stamp: bottom-right, in the page flow after the content (never floats over it, also on phones). *@
    <footer class="po-foot"><span class="po-stamp">v@(BuildStamp)</span></footer>
</div>

<FirstRunTour />

@code {
    private ErrorBoundary? _errorBoundary;

    private static readonly string BuildStamp = typeof(MainLayout).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value ?? "dev";

    private string Page => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
    private bool IsControlPage => Page.Length == 0;
    private string HealthLinkClass => Page is "robustness" or "diag" ? "po-nav__link active" : "po-nav__link";

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnChanged;
        Nav.LocationChanged += OnLocation;
        await Ui.InitAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocation;
    }
}
