@inherits LayoutComponentBase
@implements IDisposable
@using System.Reflection
@inject UiState Ui
@inject NavigationManager Nav

<RadzenComponents />

<div class="po-shell">
    <header class="po-header">
        <a class="po-header__brand" href="/" style="text-decoration:none;color:inherit" title="Home">
            <span class="po-logo">R1</span>
            <div>
                <div class="po-title">PoRobotTrain</div>
                <div class="po-subtitle">Train on the virtual robot, then run on the R1</div>
            </div>
        </a>
        @* The five-step flow is the navigation; the Library (every trained skill: versions, retrain, copy to robot, view)
           opens after step 1. Health, Setup, Motions and Walk appear with Advanced, as does the Ask bar. *@
        <nav class="po-nav" aria-label="Main">
            <StepNav />
            @if (Ui.StepDone(1))
            {
                <NavLink href="/library" class="po-nav__link po-nav__link--library">Library</NavLink>
            }
            else
            {
                <span class="po-nav__link po-nav__link--locked" title="Finish step 1 (Check) first">Library</span>
            }
            @if (Ui.Advanced)
            {
                <NavLink href="/robot-health" class="@HealthLinkClass">Health</NavLink>
                <NavLink href="/setup" class="po-nav__link">Setup</NavLink>
                <NavLink href="/motions" class="po-nav__link">Motions</NavLink>
                <NavLink href="/walk" class="po-nav__link">Walk</NavLink>
            }
            <HelpDrawer />
        </nav>
        <div class="po-header__right">
            <RobotBadge />
            <label class="adv-toggle" title="Show expert tools: modes, limits, calibration, network, versions, the 26-joint matrix and raw logs">
                <input type="checkbox" checked="@Ui.Advanced" @onchange="e => Ui.SetAdvancedAsync((bool)e.Value!)" /> Advanced
            </label>
            <EstopButton />
            @if (Ui.Advanced)
            {
                <span class="po-stamp">v@(BuildStamp)</span>
            }
        </div>
    </header>

    @if (Ui.Advanced)
    {
        <AskBar />
    }

    <main class="po-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="po-card po-card--danger">
                    <h2>UI Error</h2>
                    <p>@ex.Message</p>
                    <button type="button" class="po-btn" @onclick="Recover">Recover</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

<FirstRunTour />

@code {
    private ErrorBoundary? _errorBoundary;

    private static readonly string BuildStamp = typeof(MainLayout).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value ?? "dev";

    private string Page => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
    private string HealthLinkClass => Page is "robustness" or "diag" ? "po-nav__link active" : "po-nav__link";

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnChanged;
        Nav.LocationChanged += OnLocation;
        await Ui.InitAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose()
    {
        Ui.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocation;
    }
}
