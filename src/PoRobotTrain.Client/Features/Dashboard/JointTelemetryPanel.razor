@using System.Globalization
@using PoRobotTrain.Client.Features.Dashboard.Twin

<div class="po-card">
    <div class="tel-header" style="flex-wrap:wrap">
        <div>
            <h2 class="tel-title">
                @(PracticeActive
                    ? (_wantReal ? "VIRTUAL ROBOT — CURRENT POSE" : "VIRTUAL ROBOT PREVIEW RUN — POSE")
                    : (_wantReal ? "REAL ROBOT — CURRENT POSE" : "VIRTUAL ROBOT PREVIEW RUN — POSE"))
            </h2>
            <div class="tel-metrics">
                @if (ActiveTelemetry?.ImuRpyDeg is { Length: >= 3 } imu)
                {
                    <span>IMU R/P/Y: <b>@($"{imu[0]:+0.0;-0.0;+0.0} / {imu[1]:+0.0;-0.0;+0.0} / {imu[2]:+0.0;-0.0;+0.0}°")</b></span>
                }
                else
                {
                    <span>IMU: <b>--</b></span>
                }
                @if (_wantReal)
                {
                    <span>Mode: <b>@(ActiveRealOrPractice?.ModeMachine?.ToString(CultureInfo.InvariantCulture) ?? "--")</b></span>
                    <span>Motors: <b>@(HasRealOrPractice26 ? $"{ActiveRealOrPractice?.ActiveMotors ?? 0}/26" : "--")</b></span>
                    <span>Max Temp: <b>@(ActiveRealOrPractice?.MaxTempC?.ToString(CultureInfo.InvariantCulture) ?? "--")°C</b></span>
                    <span>Bus: <b>@(ActiveRealOrPractice?.BusV is double v ? $"{v:0.0} V" : "--")</b></span>
                }
                else
                {
                    <span>Limits: <b>r1_joint_map.yaml</b></span>
                }
            </div>
        </div>
        <div class="size-row">
            @if (!PracticeActive)
            {
                <RadzenButton class="@($"po-plain po-chip {(_wantReal ? " active" : string.Empty)}")" Click="() => _wantReal = true">Real robot</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(!_wantReal ? " active" : string.Empty)}")" Click="() => _wantReal = false">Virtual robot preview</RadzenButton>
            }
            else
            {
                <RadzenButton class="@($"po-plain po-chip {(_wantReal ? " active" : string.Empty)}")" Click="() => _wantReal = true">Virtual robot</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(!_wantReal ? " active" : string.Empty)}")" Click="() => _wantReal = false">Virtual robot preview</RadzenButton>
            }
            @if (_wantReal)
            {
                <RadzenButton class="@($"po-plain po-btn {(_realWriteArmed ? (PracticeActive ? " po-btn--blue" : "po-btn--orange") : (PracticeActive ? "po-btn--blue-soft" : "po-btn--orange-soft"))}")" style="padding:6px 10px;font-size:12px" Click="ToggleRealWrite">
                    @(_realWriteArmed
                        ? (PracticeActive ? "Sliders move the virtual robot" : "Sliders move the REAL robot")
                        : "Sliders: read-only (enable)")
                </RadzenButton>
                @if (_realWriteArmed)
                {
                    <label class="po-muted" style="display:inline-flex;align-items:center;gap:4px;cursor:pointer">
                        <RadzenCheckBox TValue="bool" @bind-Value="_upperUnlocked" />
                        Arms/Waist
                    </label>
                }
            }
            else
            {
                <RadzenButton class="@($"po-plain po-chip {(_virtTarget == " urlab" ? "active" : string.Empty)}")" Click='() => _virtTarget = "urlab"'>Unreal</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(_virtTarget == " sim" ? "active" : string.Empty)}")" Click='() => _virtTarget = "sim"'>Built-in</RadzenButton>
            }
            <RadzenButton class="@($"po-plain po-btn {(PracticeActive ? " po-btn--blue-soft" : "po-btn--orange-soft")}")" style="padding:6px 10px;font-size:12px" Disabled="@(!IsIdle)" Click="ReadPhysicalAsync">
                @(IsReading ? "Reading..." : (PracticeActive ? "Read virtual robot pose" : "Read robot pose"))
            </RadzenButton>
            <span class="po-pill @BadgeClass">@BadgeText</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(BannerText))
    {
        <div class="status-msg @BannerClass">@BannerText</div>
    }
    @if (_wantReal && _realWriteArmed)
    {
        <div class="status-msg warn">
            <b>@(PracticeActive ? "PRACTICE SLIDERS ARMED -> VIRTUAL ROBOT (PC):" : "SLIDER WRITE ARMED -> PHYSICAL R1 (192.168.123.164):")</b> dragging a slider smoothly powers only that joint (torque/limit capped; legs stay stand-locked; e-stop: L2+B 5s).
        </div>
    }

    @if (_draggingJoint is not null && _twinFeedback.HasHits)
    {
        <div class="status-msg warn">
            <b>Proposed pose check (Rapier, MuJoCo collision capsules):</b> @PreviewHitText
        </div>
    }

    @if (Simple && !_showJoints && HighlightJoint is null)
    {
        <RadzenButton class="po-plain po-chip joints-toggle" Click="() => _showJoints = true">Show all 26 joints (sliders and angles)</RadzenButton>
    }
    else
    {
    if (Simple)
    {
        <RadzenButton class="po-plain po-chip joints-toggle" Click="() => _showJoints = false">Hide the joint list</RadzenButton>
    }
    <div class="groups-grid">
        @foreach (var grp in RobotJointCatalog.GroupOrder)
        {
            var joints = RobotJointCatalog.All.Where(j => j.Group == grp.Group).ToList();
            var isLeg = grp.Group is JointGroup.LeftLeg or JointGroup.RightLeg;
            <div class="group-card" style="border-left-color:@grp.ColorHex">
                <div class="group-hdr">
                    <span style="color:@grp.ColorHex">
                        @grp.Title
                        @if (isLeg) { <span style="opacity:.65"> · STAND READ-ONLY</span> }
                    </span>
                    <span>RANGE / ANGLE / T</span>
                </div>
                @foreach (var j in joints)
                {
                    var span = Math.Max(1.0, j.MaxDeg - j.MinDeg);
                    var defDeg = (Status?.JointDefaultsDeg is { Count: >= 26 } defs) ? defs[j.PolicyIndex] : j.DefaultDeg;
                    var nd = Math.Clamp((defDeg - j.MinDeg) / span, 0.0, 1.0);
                    var rawVal = ResolveAngleOrNull(j);
                    var isDragging = _draggingJoint == j.Name;
                    var displayDeg = isDragging ? _draggingDeg : rawVal;
                    var sliderVal = displayDeg ?? defDeg;
                    var writable = IsWritable(j, grp.Group) && IsIdle;
                    var sliderDisabled = !writable;
                    var nv = rawVal is double rv ? Math.Clamp((rv - j.MinDeg) / span, 0.0, 1.0) : (double?)null;
                    var margin = nv is double nvv ? Math.Min(nvv, 1.0 - nvv) : 1.0;
                    var degMargin = rawVal is double drv ? Math.Min(drv - j.MinDeg, j.MaxDeg - drv) : 99.0;
                    var barCol = (margin < 0.03 && degMargin < 4.0) ? "#ff5c57"
                        : (margin < 0.07 && degMargin < 8.0) ? "#ffbd42"
                        : _wantReal ? "#ff9c47" : "#3dc7f2";
                    var tempText = (_wantReal && Real?.TempsC is { } temps && j.PolicyIndex < temps.Length)
                        ? $"{temps[j.PolicyIndex]}°"
                        : "--";

                    <div class="jrow @(j.Name == HighlightJoint ? "jrow--hl" : string.Empty)" id="joint-@j.Name">
                        <span class="jname" title="@j.Name">@j.DisplayLabel</span>
                        <div class="jbar">
                            <div class="jbar-track" style="position:absolute;inset:0;top:5px">
                                <div class="def" style="left:@($"{nd * 100:0.##}%")"></div>
                                @if (nv is double nvv2)
                                {
                                    var fillLeft = Math.Min(nd, nvv2) * 100.0;
                                    var fillWidth = Math.Max(1.5, Math.Abs(nvv2 - nd) * 100.0);
                                    <div class="fill" style="left:@($"{fillLeft:0.##}%");width:@($"{fillWidth:0.##}%");background:@barCol"></div>
                                }
                            </div>
                            @* RadzenSlider reports every step while dragging (preview only); the joint is moved once, when the
                               pointer or key is released over it (the wrapper), like the native range input's change event. *@
                            <div class="jslider-wrap" @onpointerup="() => CommitDragAsync(j.Name)" @onkeyup="() => CommitDragAsync(j.Name)">
                                <RadzenSlider TValue="double" class="@($"jslider {(_wantReal ? string.Empty : "jslider--virt")}")"
                                              Min="(decimal)j.MinDeg" Max="(decimal)j.MaxDeg" Step="0.5"
                                              Value="@Math.Round(sliderVal, 1)" Disabled="@sliderDisabled"
                                              title="@(writable ? $"Drag to move {j.Name} ({j.MinDeg:0}° .. {j.MaxDeg:0}°)" : isLeg ? "Leg joint is stand-locked read-only" : _wantReal ? "Enable 'Write Physical R1' above to move physical joint" : "Virtual sim busy")"
                                              aria-label="@j.Name"
                                              ValueChanged="@((double v) => OnSliderInput(j.Name, v.ToString(CultureInfo.InvariantCulture)))" />
                            </div>
                        </div>
                        <span class="jang" style="color:@(isDragging ? "#fff" : rawVal is null ? "var(--po-muted)" : (margin < 0.07 && degMargin < 8.0 ? barCol : "inherit"))">
                            @(isDragging ? $"→{_draggingDeg:+0.0;-0.0;+0.0}°" : rawVal is double v ? $"{v:+0.0;-0.0;+0.0}°" : "--")
                        </span>
                        <span class="jtemp">@tempText</span>
                    </div>
                }
            </div>
        }
    </div>

    }

    <div class="stand-card">
        <div class="sec-hdr">
            <div>
                <strong style="font-size:14px">3D R1 ON STAND (LIVE POSE)</strong>
                <span class="po-muted" style="margin-left:8px">@(_wantReal ? (PracticeActive ? "Virtual robot pose" : "Real robot pose") : "Virtual robot preview run")</span>
            </div>
            <div class="size-row">
                <RadzenButton class="@($"po-plain po-chip {(_cam == " iso" ? "active" : string.Empty)}")" Click='() => _cam = "iso"'>3/4 Iso</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(_cam == " front" ? "active" : string.Empty)}")" Click='() => _cam = "front"'>Front</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(_cam == " side" ? "active" : string.Empty)}")" Click='() => _cam = "side"'>Side</RadzenButton>
                <RadzenButton class="@($"po-plain po-chip {(_cam == " back" ? "active" : string.Empty)}")" Click='() => _cam = "back"'>Back</RadzenButton>
            </div>
        </div>
        <Twin3DView Actual="ActiveTelemetry?.QDeg"
                    Sim="@(_wantReal ? Virt?.QDeg : null)"
                    Temps="@(_wantReal ? Real?.TempsC : null)"
                    WantReal="_wantReal"
                    RealConnected="@(Status?.RealConnected ?? false)"
                    Camera="@_cam"
                    Preview="TwinPreviewPose"
                    Job="@Status?.Job"
                    Results="@Status?.Results"
                    PrimaryJoint="@(ActiveTelemetry?.PrimaryJoint ?? Virt?.PrimaryJoint)"
                    Behaviour="@SelectedBehaviour"
                    Amplitude="SelectedAmplitude"
                    FallbackUrl="@StandViewUrl"
                    OnFeedback="fb => _twinFeedback = fb" />
    </div>

    @if (!Simple)
    {
    <JointHistoryHeatmap Actual="ActiveTelemetry?.QDeg"
                         Sim="@(_wantReal ? Virt?.QDeg : null)"
                         SampleTime="ActiveTelemetry?.T"
                         SourceLabel="@(_wantReal ? (PracticeActive ? "Virtual robot" : "Real robot") : "Virtual robot preview run")" />
    }
</div>

@if (_armConfirmOpen)
{
    <div class="po-modal-bg">
        <div class="po-modal">
            <h2>@(PracticeActive ? "ARM SLIDERS FOR PRACTICE VIRTUAL ROBOT?" : "ARM SLIDER WRITE -> PHYSICAL R1?")</h2>
            @if (PracticeActive)
            {
                <p>Physical R1 is not connected — moving upper-body sliders will smoothly move the <b>virtual robot</b> for practice.</p>
            }
            else
            {
                <p>Moving upper-body sliders will send powered smooth-ramp commands to the <b>real hardware</b> at 192.168.123.164.</p>
            }
            <p>Only the single joint you drag is powered (limit &amp; torque capped; legs stay stand-locked).</p>
            <div class="btn-row">
                <RadzenButton class="@($"po-plain po-btn {(PracticeActive ? " po-btn--blue" : "po-btn--orange")}")" style="flex:1" Click="ConfirmArmWrite">
                    @(PracticeActive ? "Yes, enable practice sliders" : "Yes, enable physical sliders")
                </RadzenButton>
                <RadzenButton class="po-plain po-btn" Click="() => _armConfirmOpen = false">Cancel</RadzenButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public RobotStatusDto? Status { get; set; }
    [Parameter] public bool IsIdle { get; set; }
    [Parameter] public bool PracticeActive { get; set; }
    [Parameter] public EventCallback OnReadPhysical { get; set; }
    [Parameter] public EventCallback<MoveJointRequest> OnMoveJoint { get; set; }
    [Parameter] public string SelectedBehaviour { get; set; } = "neck_turn";
    [Parameter] public double SelectedAmplitude { get; set; } = 10.0;
    [Parameter] public string? HighlightJoint { get; set; }

    /// <summary>Simple view (Advanced off): the 3D virtual robot first, the 26-joint list folded away, no history heatmap.</summary>
    [Parameter] public bool Simple { get; set; }

    private bool _showJoints;

    private TwinFeedback _twinFeedback = TwinFeedback.Empty;

    private TwinPreview? TwinPreviewPose =>
        _draggingJoint is not null && RobotJointCatalog.All.FirstOrDefault(j => j.Name == _draggingJoint) is { } dj
            ? new TwinPreview(dj.PolicyIndex, _draggingDeg)
            : null;

    private string PreviewHitText =>
        string.Join("; ",
            _twinFeedback.Self.Select(h => $"{Pretty(h.A)} ↔ {Pretty(h.B)} {h.DistanceM * 1000:0} mm")
                .Concat(_twinFeedback.Stand.Select(h => $"{Pretty(h.A)} near the stand frame ({h.DistanceM * 1000:0} mm; the stand is not in MuJoCo's contact model)")))
        + ". Display-only warning: release the slider only if you intend this pose.";

    private static string Pretty(string body) =>
        RobotJointCatalog.All.FirstOrDefault(j => body.StartsWith(j.Name.Replace("_joint", string.Empty, StringComparison.Ordinal), StringComparison.Ordinal))?.DisplayLabel
        ?? body.Replace("_link", string.Empty, StringComparison.Ordinal).Replace('_', ' ');

    private bool _wantReal = true;
    private bool _realWriteArmed;
    private bool _upperUnlocked;
    private bool _armConfirmOpen;
    private string _virtTarget = "urlab";
    private string _cam = "iso";
    private string? _draggingJoint;
    private double _draggingDeg;

    private string StandViewUrl
    {
        get
        {
            var mode = _wantReal ? "real" : "virtual";
            var qHash = ActiveTelemetry?.QDeg is { } q
                ? string.Join(',', q.Select(v => v.ToString("0.0", CultureInfo.InvariantCulture)))
                : $"{RealHead?.Yaw:0.0},{RealHead?.Pitch:0.0}";
            var url = $"/api/robot/view.png?mode={mode}&cam={_cam}";
            if (_draggingJoint is not null)
            {
                var ji = RobotJointCatalog.All.FirstOrDefault(j => j.Name == _draggingJoint)?.PolicyIndex;
                if (ji is int idx)
                {
                    url += $"&j={idx}&deg={_draggingDeg.ToString("0.0", CultureInfo.InvariantCulture)}";
                }
            }
            return $"{url}&h={Uri.EscapeDataString(qHash)}";
        }
    }

    private TelemetryReadoutDto? Real => Status?.Telemetry.GetValueOrDefault("real");
    private TelemetryReadoutDto? Practice => Status?.Telemetry.GetValueOrDefault("practice");
    private TelemetryReadoutDto? Virt => Status?.Telemetry.GetValueOrDefault("virtual");
    private HeadReadoutDto? RealHead => Status?.Head.GetValueOrDefault("real");

    private bool HasReal26 => Real?.QDeg is { Length: >= 26 };
    private bool HasPractice26 => Practice?.QDeg is { Length: >= 26 };
    private bool UsingPractice => !HasReal26 && PracticeActive && HasPractice26;
    private TelemetryReadoutDto? ActiveRealOrPractice => HasReal26 ? Real : (UsingPractice ? Practice : null);
    private bool HasRealOrPractice26 => HasReal26 || UsingPractice;
    private bool HasVirt26 => Virt?.QDeg is { Length: >= 26 };
    private bool HasHeadOnly => _wantReal && !HasRealOrPractice26 && (RealHead?.Yaw is not null || RealHead?.Pitch is not null);
    private bool IsReading => string.Equals(Status?.Job, "snapshot", StringComparison.OrdinalIgnoreCase);

    private TelemetryReadoutDto? ActiveTelemetry =>
        _wantReal ? ActiveRealOrPractice : (HasVirt26 ? Virt : null);

    private bool IsWritable(JointSpec j, JointGroup grp)
    {
        if (grp is JointGroup.LeftLeg or JointGroup.RightLeg) return false;
        if (!_wantReal) return true;
        if (!_realWriteArmed) return false;
        return grp == JointGroup.Head || _upperUnlocked;
    }

    private void ToggleRealWrite()
    {
        if (_realWriteArmed)
        {
            _realWriteArmed = false;
            return;
        }
        _armConfirmOpen = true;
    }

    private void ConfirmArmWrite()
    {
        _armConfirmOpen = false;
        _realWriteArmed = true;
    }

    private void OnSliderInput(string jointName, string? raw)
    {
        if (double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var deg))
        {
            _draggingJoint = jointName;
            _draggingDeg = deg;
        }
    }

    private Task CommitDragAsync(string jointName) =>
        _draggingJoint == jointName
            ? OnSliderCommitAsync(jointName, _draggingDeg.ToString(CultureInfo.InvariantCulture))
            : Task.CompletedTask;

    private async Task OnSliderCommitAsync(string jointName, string? raw)
    {
        _draggingJoint = null;
        if (!double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var deg))
        {
            return;
        }
        if (OnMoveJoint.HasDelegate)
        {
            var tgt = _wantReal ? (PracticeActive ? "practice" : "real") : _virtTarget;
            await OnMoveJoint.InvokeAsync(new MoveJointRequest(jointName, deg, tgt, Confirm: _wantReal && _realWriteArmed));
        }
    }

    private string BadgeText => _wantReal
        ? (HasReal26
            ? ((Status?.Job is "monitor" or "run" or "snapshot") && Real?.AgeS < 2.0
                ? "REAL ROBOT LIVE"
                : $"REAL ROBOT · {Real?.AgeS:0}s AGO")
            : UsingPractice ? "VIRTUAL ROBOT"
            : HasHeadOnly ? "REAL ROBOT: HEAD ONLY"
            : IsReading ? "READING THE ROBOT…"
            : "NO ROBOT READING")
        : (HasVirt26
            ? (Status?.Job == "preview" && Virt?.AgeS < 2.0 ? "PREVIEW LIVE" : $"PREVIEW · {Virt?.AgeS:0}s AGO")
            : "NO PREVIEW RUN YET");

    private string BadgeClass => _wantReal
        ? (HasReal26 || HasHeadOnly ? "po-pill--orange" : UsingPractice ? "po-pill--blue" : string.Empty)
        : (HasVirt26 ? "po-pill--blue" : string.Empty);

    private string? SnapshotOrMonitorFail =>
        Status?.Results.GetValueOrDefault("snapshot") is { Ok: false } sf ? sf.Reason
        : Status?.Results.GetValueOrDefault("monitor") is { Ok: false } mf ? mf.Reason
        : null;

    private string BannerText
    {
        get
        {
            if (_wantReal)
            {
                if (HasReal26) return string.Empty;
                if (UsingPractice)
                    return "Showing the virtual robot (the real robot is not connected). Nothing physical moves.";
                if (HasHeadOnly)
                    return "Only the head angles arrived from the check. Press 'Read robot pose' for all 26 joints.";
                if (PracticeActive)
                    return "The real robot is not connected. Press 'Read virtual robot pose' to show the virtual robot.";
                if (!string.IsNullOrEmpty(SnapshotOrMonitorFail))
                    return $"Could not read the robot ({SnapshotOrMonitorFail}). Angles show '--' rather than guesses.";
                return "No reading from the robot yet (angles show '--', never guesses). Press 'Read robot pose' once it is online.";
            }
            return HasVirt26 ? string.Empty : "No preview run yet: run a motion on the virtual robot to see it here.";
        }
    }

    private string BannerClass => _wantReal && !string.IsNullOrEmpty(SnapshotOrMonitorFail) ? "bad"
        : HasHeadOnly ? "warn"
        : "info";

    private async Task ReadPhysicalAsync()
    {
        _wantReal = true;
        if (OnReadPhysical.HasDelegate)
        {
            await OnReadPhysical.InvokeAsync();
        }
    }

    private double? ResolveAngleOrNull(JointSpec j)
    {
        if (ActiveTelemetry?.QDeg is { } q && j.PolicyIndex < q.Length)
        {
            return q[j.PolicyIndex];
        }
        if (HasHeadOnly && RealHead is not null)
        {
            if (j.Name == "head_pitch_joint" && RealHead.Pitch is double hp) return hp;
            if (j.Name == "head_yaw_joint" && RealHead.Yaw is double hy) return hy;
        }
        return null;
    }
}
