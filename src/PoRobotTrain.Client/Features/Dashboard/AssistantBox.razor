@using System.Text.Json
@using PoRobotTrain.Client.Features.Dashboard.Twin
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Plain-language picker (Transformers.js, runs locally after a one-time model download). It only fills in the
   Behaviour / Sweep Size selection or points at a joint slider; Steps 1 + 2 and the confirm dialog still gate any run. *@
<div class="assist">
    <form class="assist-row" @onsubmit="AskAsync" @onsubmit:preventDefault>
        <input class="assist-input" placeholder="@(_loaded ? "e.g. nod the head 20 degrees" : "Ask in plain words (loads a 23 MB local model once)")"
               @bind="_text" @bind:event="oninput" disabled="@_busy" aria-label="Describe the motion" />
        <button type="submit" class="po-chip" disabled="@(_busy || string.IsNullOrWhiteSpace(_text))">
            @(_busy ? (_loaded ? "Thinking…" : _progress ?? "Loading model…") : "Suggest")
        </button>
    </form>
    @if (_suggestion is { } s)
    {
        <div class="assist-out @(s.Kind == "unknown" || s.Blocked ? "warn" : string.Empty)">
            <span>@s.Note</span>
            @if (s.Kind == "behaviour" && !s.Blocked && s.Id is not null)
            {
                <button type="button" class="po-chip active" @onclick="ApplyAsync">Select @s.Label@(s.Amplitude is double a ? $" {a:0}°" : string.Empty)</button>
            }
            else if (s.Kind == "joint" && s.Joint is not null)
            {
                <button type="button" class="po-chip" @onclick="ShowJointAsync">Show @s.Label slider</button>
            }
        </div>
    }
    @if (_error is not null)
    {
        <div class="assist-out warn">Assistant unavailable: @_error</div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BehaviourInfoDto> Behaviours { get; set; } = [];
    [Parameter] public bool ArmUnlocked { get; set; }
    [Parameter] public EventCallback<(string Behaviour, double? Amplitude)> OnSelectBehaviour { get; set; }
    [Parameter] public EventCallback<string> OnShowJoint { get; set; }

    private static readonly double[] Sizes = [10.0, 20.0, 30.0];
    private IJSObjectReference? _module;
    private string _text = string.Empty;
    private bool _busy;
    private bool _loaded;
    private string? _progress;
    private string? _error;
    private AssistantSuggestion? _suggestion;

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(_text))
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/twin/assistant.js");
            if (!_loaded)
            {
                _progress = "Loading model…";
                StateHasChanged();
                await _module.InvokeVoidAsync("load");
                _loaded = true;
            }
            var req = new AssistantRequest(
                _text,
                Behaviours.Select(b => new AssistantBehaviour(b.Id, b.Label, b.Desc, b.MaxDeg)).ToList(),
                RobotJointCatalog.All.Select(j => new AssistantJoint(j.Name, j.DisplayLabel, j.Group.ToString(), j.MinDeg, j.MaxDeg)).ToList(),
                Sizes,
                ArmUnlocked);
            var json = await _module.InvokeAsync<string>("interpretJson", JsonSerializer.Serialize(req, TwinInteropJsonContext.Default.AssistantRequest));
            _suggestion = JsonSerializer.Deserialize(json, TwinInteropJsonContext.Default.AssistantSuggestion);
        }
        catch (JSException ex)
        {
            _error = ex.Message.Split('\n')[0];
        }
        finally
        {
            _busy = false;
            _progress = null;
        }
    }

    private async Task ApplyAsync()
    {
        if (_suggestion?.Id is string id && OnSelectBehaviour.HasDelegate)
        {
            await OnSelectBehaviour.InvokeAsync((id, _suggestion.Amplitude));
        }
    }

    private async Task ShowJointAsync()
    {
        if (_suggestion?.Joint is string joint && OnShowJoint.HasDelegate)
        {
            await OnShowJoint.InvokeAsync(joint);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // page is going away
        }
    }
}
