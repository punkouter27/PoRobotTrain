@implements IAsyncDisposable
@inject IJSRuntime JS

@* 26-joint history strip (one canvas pixel per cell, painted by js/heatmap.js): one row per joint (policy order, grouped), one column per
   telemetry sample. Shows at a glance which joints moved, which approached their limits, and where the
   virtual sim and the physical / practice robot disagreed during a run. *@
<div class="hist-card">
    <div class="sec-hdr">
        <div>
            <strong style="font-size:14px">JOINT HISTORY</strong>
            <span class="po-muted" style="margin-left:8px">@SourceLabel · last @_count of @Capacity samples</span>
        </div>
        <div class="size-row">
            <RadzenButton class="@($"po-plain po-chip {(_mode == HistMode.Position ? " active" : string.Empty)}")" Click="() => SetMode(HistMode.Position)">Position</RadzenButton>
            <RadzenButton class="@($"po-plain po-chip {(_mode == HistMode.Margin ? " active" : string.Empty)}")" Click="() => SetMode(HistMode.Margin)">Limit margin</RadzenButton>
            <RadzenButton class="@($"po-plain po-chip {(_mode == HistMode.Error ? " active" : string.Empty)}")" Disabled="@(!_anyError)" title="Needs both a virtual run and a physical / practice reading" Click="() => SetMode(HistMode.Error)">Sim − real</RadzenButton>
            <RadzenButton class="po-plain po-chip" Click="Clear">Clear</RadzenButton>
        </div>
    </div>
    <div class="hist-body">
        <div class="hist-labels" style="height:@(RowsHeight)px">
            @foreach (var g in RobotJointCatalog.GroupOrder)
            {
                var n = RobotJointCatalog.All.Count(j => j.Group == g.Group);
                <div style="height:@(n * RowH)px;border-left:3px solid @g.ColorHex;color:@g.ColorHex">@g.Title</div>
            }
        </div>
        <canvas @ref="_canvas" class="hist-canvas" width="@Capacity" height="@Rows" style="@($"height:{RowsHeight}px")" aria-label="Joint history heatmap"></canvas>
    </div>
    <div class="hist-scale">@ScaleText</div>
</div>

@code {
    private const int Capacity = 240;
    private const int RowH = 9;
    private const int Rows = 26;

    private enum HistMode { Position, Margin, Error }

    [Parameter] public double[]? Actual { get; set; }
    [Parameter] public double[]? Sim { get; set; }
    [Parameter] public double? SampleTime { get; set; }
    [Parameter] public string SourceLabel { get; set; } = "";

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private bool _dirty = true;
    private readonly double[][] _q = new double[Capacity][];
    private readonly double[]?[] _err = new double[Capacity][];
    private int _head;
    private int _count;
    private double? _lastT;
    private string? _lastKey;
    private HistMode _mode = HistMode.Position;
    private bool _anyError;

    private static int RowsHeight => Rows * RowH;

    // row order: group order used by the panel, then policy order inside a group
    private static readonly int[] RowJoint = RobotJointCatalog.GroupOrder
        .SelectMany(g => RobotJointCatalog.All.Where(j => j.Group == g.Group).Select(j => j.PolicyIndex))
        .ToArray();

    private string ScaleText => _mode switch
    {
        HistMode.Position => "colour = angle inside its r1_joint_map.yaml range (blue = min, white = default, orange = max)",
        HistMode.Margin => "colour = distance to the nearest limit (green ≥ 25°, amber < 8°, red < 4°)",
        _ => "colour = |virtual sim − physical/practice| (black 0°, violet 2°, white ≥ 8°)",
    };

    protected override void OnParametersSet()
    {
        if (Actual is not { Length: >= Rows })
        {
            return;
        }
        var key = SampleTime?.ToString(System.Globalization.CultureInfo.InvariantCulture)
            ?? string.Join(',', Actual.Select(v => Math.Round(v, 1)));
        if (key == _lastKey && SampleTime == _lastT)
        {
            return;
        }
        _lastKey = key;
        _lastT = SampleTime;
        _q[_head] = (double[])Actual.Clone();
        _err[_head] = Sim is { Length: >= Rows } s ? Actual.Select((v, i) => Math.Abs(v - s[i])).ToArray() : null;
        _anyError |= _err[_head] is not null;
        _head = (_head + 1) % Capacity;
        _count = Math.Min(Capacity, _count + 1);
        _dirty = true;
    }

    private void SetMode(HistMode m)
    {
        _mode = m;
        _dirty = true;
    }

    private void Clear()
    {
        _count = 0;
        _head = 0;
        _anyError = false;
        _dirty = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dirty)
        {
            return;
        }
        _dirty = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/heatmap.js");
            await _module.InvokeVoidAsync("paint", _canvas, Pixels(), Capacity, Rows);
        }
        catch (JSException)
        {
            // the strip is informational; a failed paint leaves the previous frame
        }
    }

    // RGBA, row-major: one row per joint (RowJoint order), newest sample in the right-most column
    private byte[] Pixels()
    {
        var px = new byte[Capacity * Rows * 4];
        for (var i = 0; i < Capacity * Rows; i++)
        {
            px[i * 4] = 0x0a;
            px[i * 4 + 1] = 0x0c;
            px[i * 4 + 2] = 0x10;
            px[i * 4 + 3] = 0xff;
        }
        for (var c = 0; c < _count; c++)
        {
            var idx = (_head - _count + c + Capacity) % Capacity;
            var q = _q[idx];
            var err = _err[idx];
            var x = Capacity - _count + c;
            for (var r = 0; r < Rows; r++)
            {
                var j = RobotJointCatalog.All[RowJoint[r]];
                var col = _mode switch
                {
                    HistMode.Position => PositionColor(j, q[j.PolicyIndex]),
                    HistMode.Margin => MarginColor(j, q[j.PolicyIndex]),
                    _ => err is null ? new Rgb(0x15, 0x18, 0x20) : ErrorColor(err[j.PolicyIndex]),
                };
                var o = (r * Capacity + x) * 4;
                px[o] = col.R;
                px[o + 1] = col.G;
                px[o + 2] = col.B;
            }
        }
        return px;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private readonly record struct Rgb(byte R, byte G, byte B);

    private static Rgb Lerp(Rgb a, Rgb b, double t)
    {
        t = Math.Clamp(t, 0, 1);
        return new Rgb(
            (byte)(a.R + (b.R - a.R) * t),
            (byte)(a.G + (b.G - a.G) * t),
            (byte)(a.B + (b.B - a.B) * t));
    }

    private static readonly Rgb Blue = new(0x3d, 0xc7, 0xf2);
    private static readonly Rgb White = new(0xee, 0xf1, 0xf7);
    private static readonly Rgb Orange = new(0xff, 0x9c, 0x47);
    private static readonly Rgb Green = new(0x2f, 0x9e, 0x63);
    private static readonly Rgb Amber = new(0xff, 0xbd, 0x42);
    private static readonly Rgb Red = new(0xff, 0x5c, 0x57);
    private static readonly Rgb Violet = new(0xb1, 0x8c, 0xff);
    private static readonly Rgb Black = new(0x10, 0x12, 0x18);

    private static Rgb PositionColor(JointSpec j, double q)
    {
        if (q <= j.DefaultDeg)
        {
            return Lerp(Blue, White, (q - j.MinDeg) / Math.Max(1e-6, j.DefaultDeg - j.MinDeg));
        }
        return Lerp(White, Orange, (q - j.DefaultDeg) / Math.Max(1e-6, j.MaxDeg - j.DefaultDeg));
    }

    private static Rgb MarginColor(JointSpec j, double q)
    {
        var m = Math.Min(q - j.MinDeg, j.MaxDeg - q);
        return m < 4 ? Red : m < 8 ? Amber : Lerp(Amber, Green, (m - 8) / 17.0);
    }

    private static Rgb ErrorColor(double e) =>
        e < 2 ? Lerp(Black, Violet, e / 2) : Lerp(Violet, White, (e - 2) / 6);
}
