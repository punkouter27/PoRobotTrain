@page "/"
@inject UiState Ui
@inject NavigationManager Nav

<PageTitle>PoRobotTrain</PageTitle>

@* Home opens the first step that is not done yet (the five-step flow, Layout/StepNav.razor). Links from the Ask box and
   older bookmarks (/?behaviour=..., /?joint=...) open the matching page instead. *@
<p class="po-muted">Opening your next step…</p>

@code {
    [SupplyParameterFromQuery(Name = "behaviour")] public string? QueryBehaviour { get; set; }
    [SupplyParameterFromQuery(Name = "amp")] public double? QueryAmp { get; set; }
    [SupplyParameterFromQuery(Name = "joint")] public string? QueryJoint { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Ui.InitAsync();
        if (QueryBehaviour is { Length: > 0 } qb)
        {
            Nav.NavigateTo($"/mission?behaviour={Uri.EscapeDataString(qb)}{(QueryAmp is double a ? $"&amp={a:0}" : string.Empty)}", replace: true);
        }
        else if (QueryJoint is { Length: > 0 } qj)
        {
            Nav.NavigateTo($"/mission?joint={Uri.EscapeDataString(qj)}", replace: true);
        }
        else
        {
            Nav.NavigateTo(UiState.Steps[Ui.CurrentStep - 1].Route, replace: true);
        }
    }
}
