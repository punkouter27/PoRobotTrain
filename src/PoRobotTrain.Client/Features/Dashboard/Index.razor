@page "/"
@implements IDisposable
@inject RobotApiClient Api
@inject UiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Control — PoRobotTrain</PageTitle>

@* Simplified Control page: a short task chooser (#1), one name per target, Twin vs Real robot (#3), the four-step
   real-robot progress bar (#2), a reason under every disabled button (#8) and expert detail behind Advanced (#4).
   The gates themselves are unchanged: preview, read-only check, pre-flight and confirmation still all apply. *@

@if (Ui.Task is null)
{
    <section class="po-card chooser">
        <h1 class="dash-h1">WHAT DO YOU WANT TO DO?</h1>
        <p class="po-muted">@(RealConnected ? "The real robot is connected." : "No real robot connected: everything runs on the twin, a safe simulated copy.") You can switch task at any time.</p>
        <div class="chooser__grid">
            @foreach (var t in Tasks)
            {
                <RadzenButton class="@($"po-plain chooser__card chooser__card--{(t.Tone)}")" Click="() => ChooseAsync(t.Id)">
                    <span class="chooser__icon" aria-hidden="true">@t.Icon</span>
                    <span class="chooser__title">@t.Title</span>
                    <span class="chooser__desc">@t.Desc</span>
                </RadzenButton>
            }
        </div>
    </section>
}
else
{
    <nav class="taskbar" aria-label="Task">
        @foreach (var t in Tasks)
        {
            <RadzenButton class="@($"po-plain po-chip {(Ui.Task == t.Id ? " active" : string.Empty)}")" Click="() => ChooseAsync(t.Id)">@t.Icon @t.Title</RadzenButton>
        }
        <RadzenButton class="po-plain po-chip" Click="() => Ui.SetTaskAsync(null)">All tasks</RadzenButton>
    </nav>

    <div class="dash-grid">
        <section class="po-card dash-controls">
            <div class="ctrl-top">
                <div>
                    <h1 class="dash-h1">@CurrentTask.Title.ToUpperInvariant()</h1>
                    <span class="po-muted">@CurrentTask.Desc</span>
                </div>
                <span class="po-pill @(_online ? "po-pill--ok" : "po-pill--bad")">
                    @(_online ? (_status?.Job?.ToUpperInvariant() ?? "IDLE") : "OFFLINE")
                </span>
            </div>
            @if (!_online)
            {
                <div class="why">The behaviour service is not answering. Start it with <code>python -m robotcontrol.behaviours.service</code>.</div>
            }

            @if (Ui.Task is "try" or "run")
            {
                @if (Ui.Task == "try")
                {
                    <AssistantBox Behaviours="Behaviours" ArmUnlocked="_armUnlocked" OnSelectBehaviour="ApplySuggestion" OnShowJoint="ShowJointAsync" />
                }
                <div class="ctrl-row">
                    <span class="ctrl-label">Motion</span>
                    <div class="chip-grid">
                        @foreach (var b in Behaviours)
                        {
                            var sel = b.Id == _selectedBehaviour;
                            var locked = !_armUnlocked && IsArmBehaviour(b.Id);
                            <RadzenButton class="@($"po-plain po-chip {(sel ? " active" : string.Empty)}")" Disabled="@(locked || (!IsIdle && !sel))" title="@(locked ? " Tick 'Unlock arm motions' first" : b.Desc)" Click="() => SelectBehaviour(b.Id)">
                                @b.Label
                            </RadzenButton>
                        }
                    </div>
                    @if (!_armUnlocked)
                    {
                        <div class="why">Arm Raise and Hand Wave are locked: tick <b>Unlock arm motions</b> below.</div>
                    }
                </div>
                <div class="ctrl-row">
                    <span class="ctrl-label">Size</span>
                    <div class="size-row">
                        @foreach (var amp in new[] { 10.0, 20.0, 30.0 })
                        {
                            var sel = Math.Abs(_selectedAmp - amp) < 0.01;
                            <RadzenButton class="@($"po-plain po-chip {(sel ? " active" : string.Empty)}")" Disabled="@(!IsIdle && !sel)" Click="() => SelectAmplitude(amp)">@($"{amp:0}°")</RadzenButton>
                        }
                    </div>
                </div>
                <div class="ctrl-top" style="align-items:center">
                    <div class="po-muted">@ActiveDesc</div>
                    <label class="po-muted" style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;white-space:nowrap">
                        <RadzenCheckBox TValue="bool" @bind-Value="_armUnlocked" @bind-Value:after="OnArmLockChanged" /> Unlock arm motions
                    </label>
                </div>
                @if (BusyWhy is { } busy)
                {
                    <div class="why">@busy</div>
                }
            }

            @if (Ui.Task == "try")
            {
                <div class="sub-section sub-section--virtual">
                    <div class="sec-hdr">
                        <span class="sub-title sub-title--virtual">TRY IT ON THE TWIN</span>
                        <span class="po-pill po-pill--blue">SAFE · NOTHING PHYSICAL MOVES</span>
                    </div>
                    @EngineChooser
                    <RadzenButton class="po-plain po-btn po-btn--blue" Disabled="@(!IsIdle)" Click="() => PreviewAsync(Ui.PreviewTarget)">
                        @(IsJob("preview") ? "Running on the twin…" : $"▶ Run {_selectedBehaviour.Replace('_', ' ')} {_selectedAmp:0}° on the twin")
                    </RadzenButton>
                    @if (!IsIdle && BusyWhy is { } why)
                    {
                        <div class="why">@why</div>
                    }
                    <div class="status-msg @VirtualStatusClass">@VirtualStatusText</div>
                    @RenderPrimaryGauge(VirtualPrimary, "#3dc7f2", "No twin run yet.")
                    <div class="po-muted">Happy with it? Choose <a href="" @onclick:preventDefault @onclick='() => ChooseAsync("run")'>Run on the real robot</a> to take it through the four steps.</div>
                </div>
            }

            @if (Ui.Task == "check")
            {
                <div class="sub-section @(RealConnected ? "sub-section--real" : "sub-section--virtual")">
                    <div class="sec-hdr">
                        <span class="sub-title @(RealConnected ? "sub-title--real" : "sub-title--virtual")">@(RealConnected ? "REAL ROBOT · READ-ONLY" : "REAL ROBOT NOT CONNECTED · PRACTISING ON THE TWIN")</span>
                        @if (RealConnected)
                        {
                            <span class="po-pill po-pill--orange">0 % MOTOR POWER</span>
                        }
                        else
                        {
                            <RadzenButton class="po-plain po-chip" Disabled="@(!IsIdle)" Click="ProbeRealAsync">@(IsJob("snapshot") ? "Looking for the robot…" : "Connect to the real robot")</RadzenButton>
                        }
                    </div>
                    <div class="po-muted">These only read: no motor is powered. @(RealConnected ? string.Empty : "Until the robot connects, they read the twin so you can practise.")</div>
                    <div class="btn-row">
                        <RadzenButton class="@($"po-plain po-btn {(RealConnected ? " po-btn--orange-soft" : "po-btn--blue-soft")}")" style="flex:1" Disabled="@(!IsIdle)" Click="SnapshotAsync">@(IsJob("snapshot") ? "Reading…" : "Read pose now")</RadzenButton>
                        <RadzenButton class="po-plain po-btn po-btn--teal" style="flex:1" Disabled="@(!IsIdle)" Click="MonitorAsync">@(IsJob("monitor") ? "Live view on…" : "Live view (20 s)")</RadzenButton>
                        <RadzenButton class="@($"po-plain po-btn {(RealConnected ? " po-btn--orange-soft" : "po-btn--blue-soft")}")" style="flex:1" Disabled="@(!IsIdle)" Click="CheckAsync">@(IsJob("check") ? "Checking…" : "Read-only check")</RadzenButton>
                    </div>
                    @if (BusyWhy is { } why)
                    {
                        <div class="why">@why</div>
                    }
                    <div class="status-msg @RealStatusClass">@RealStatusText</div>
                    @RenderPrimaryGauge(RealPrimary, RealConnected ? "#ff9c47" : "#3dc7f2", RealConnected ? "No reading from the robot yet." : "No twin reading yet.")
                    <div class="po-muted">More detail (temperatures, battery, IMU, camera) is on the <a href="/robot-health">Health</a> page.</div>
                </div>
            }

            @if (Ui.Task == "run")
            {
                <div class="sub-section @(RealConnected ? "sub-section--real" : "sub-section--virtual")">
                    <div class="sec-hdr">
                        <span class="sub-title @(RealConnected ? "sub-title--real" : "sub-title--virtual")">@(RealConnected ? "RUN ON THE REAL ROBOT" : "PRACTISE THE REAL-ROBOT STEPS ON THE TWIN")</span>
                        <span class="po-pill @(RealConnected ? "po-pill--orange" : "po-pill--blue")">@(RealConnected ? "POWERS THE SELECTED JOINT ONLY" : "REAL ROBOT NOT CONNECTED")</span>
                    </div>
                    <ol class="stepper" aria-label="Steps to run on the real robot">
                        @StepItem(1, "Preview on the twin", PreviewMatched, IsJob("preview"),
                            PreviewMatched ? $"{_selectedBehaviour.Replace('_', ' ')} {_selectedAmp:0}° ran cleanly on the twin." : "Run this exact motion and size on the twin first.",
                            PreviewMatched ? null : (IsIdle ? ("Run on twin", () => PreviewAsync(Ui.PreviewTarget)) : null))
                        @StepItem(2, "Read-only check", CheckMatched, IsJob("check"),
                            CheckMatched ? "Passed (valid for 5 minutes)." : PreviewMatched ? "Reads the robot with no motor power; checks it can do this motion." : "Do step 1 first.",
                            !CheckMatched && PreviewMatched && IsIdle ? ("Run check", CheckAsync) : null)
                        @StepItem(3, "Pre-flight checklist", PreflightOk, false,
                            PracticeActive ? "Not needed on the twin. On the real robot: tick the checklist on Setup." : PreflightOk ? "Complete." : $"Open: {_status?.Console?.Preflight?.Reason ?? "tick the checklist"}.",
                            null, PreflightOk ? null : "/setup")
                        @StepItem(4, RealConnected ? "Confirm and run on the robot" : "Confirm and run (practice on the twin)", false, IsJob("run"),
                            CanRunRobot ? "Ready. You will be asked to confirm: robot on its stand, area clear, remote in hand." : $"Locked: {RunLockedWhy}",
                            CanRunRobot ? (RealConnected ? "Run on the robot" : "Run practice", OpenConfirm) : null)
                    </ol>
                    <div class="status-msg @RealStatusClass">@RealStatusText</div>
                    @RenderPrimaryGauge(RealPrimary, RealConnected ? "#ff9c47" : "#3dc7f2", RealConnected ? "No reading from the robot yet." : "No twin reading yet.")
                    <div class="estop-note">Real robot emergency stop: <b>remote L2 + B, hold 5 s</b>. The E-STOP button at the top stops this app.</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_toast))
            {
                <div class="po-toast">@_toast</div>
            }

            @if (Ui.Advanced)
            {
                @if (_status?.Calibration is { } cal)
                {
                    <div class="po-muted" style="color:#8ab8ff">
                        Twin physics: @($"{cal.ControlDelayMs:0}ms") delay · @($"{cal.BusVoltageV:0.0}V") BEMF · @(cal.CompliantStand ? "compliant stand" : "rigid stand") · ±@($"{cal.PosNoiseDeg:0.00}°") noise
                    </div>
                }
                <pre class="po-log">@LogText</pre>
            }
        </section>

        <section>
            <JointTelemetryPanel Status="_status" IsIdle="IsIdle" PracticeActive="PracticeActive" OnReadPhysical="SnapshotAsync" OnMoveJoint="MoveJointAsync"
                                 SelectedBehaviour="@_selectedBehaviour" SelectedAmplitude="EffectiveAmplitude" HighlightJoint="@_highlightJoint"
                                 Simple="@(!Ui.Advanced)" />
        </section>
    </div>
}

@if (_confirmOpen)
{
    <div class="po-modal-bg">
        <div class="po-modal">
            <h2>@(PracticeActive ? "RUN THE PRACTICE STEP ON THE TWIN?" : "MOVE THE REAL ROBOT?")</h2>
            @if (PracticeActive)
            {
                <p>The real robot is not connected, so this practises step 4 on the <b>twin</b>. Nothing physical moves.</p>
            }
            else
            {
                <p>This sends motor commands to the <b>real robot</b> at 192.168.123.164. Only the selected motion's joint is powered.</p>
            }
            <p>Motion: <b>@_selectedBehaviour.Replace('_', ' ')</b> (@($"{_selectedAmp:0}°")).</p>
            <p>Robot hanging on its stand, area clear, remote in your hand?</p>
            <div class="btn-row">
                <RadzenButton class="po-plain po-btn po-btn--orange" style="flex:1" Click="ConfirmRunAsync">
                    @(PracticeActive ? "Yes, run the practice step" : "Yes, move the REAL robot")
                </RadzenButton>
                <RadzenButton class="po-plain po-btn" Click="() => _confirmOpen = false">Cancel</RadzenButton>
            </div>
        </div>
    </div>
}

@code {
    private sealed record TaskInfo(string Id, string Icon, string Title, string Desc, string Tone);

    private static readonly TaskInfo[] Tasks =
    [
        new("try", "▶", "Try a motion on the twin", "Pick a head or arm motion and watch it on the twin. Nothing physical moves.", "twin"),
        new("check", "◉", "Check the real robot", "Read the robot's pose, temperatures and sensors with no motor power.", "twin"),
        new("run", "⚑", "Run on the real robot", "Take a motion through the four safety steps, then run it on the robot.", "real"),
        new("walk", "⇢", "Drive the walk sandbox", "Walk the simulated R1 around a course with keys, a gamepad or touch sticks.", "twin"),
    ];

    private static readonly IReadOnlyList<BehaviourInfoDto> FallbackBehaviours =
    [
        new("neck_turn", "Neck Turn", "Turns head left/right. Only neck yaw motor moves.", "HEAD YAW", 30.0),
        new("neck_nod", "Neck Nod", "Nods head up/down (max 20 deg). Only neck pitch moves.", "HEAD PITCH", 20.0),
        new("arm_raise", "Arm Raise", "Gently raises/lowers right arm forward (elbow held).", "R.SHOULDER", 30.0),
        new("hand_wave", "Hand Wave", "Gentle stand-safe right-arm wave (max 20 deg).", "R.ARM WAVE", 20.0),
    ];

    [SupplyParameterFromQuery(Name = "behaviour")] public string? QueryBehaviour { get; set; }
    [SupplyParameterFromQuery(Name = "amp")] public double? QueryAmp { get; set; }
    [SupplyParameterFromQuery(Name = "joint")] public string? QueryJoint { get; set; }

    private RobotStatusDto? _status;
    private bool _online;
    private string _selectedBehaviour = "neck_turn";
    private double _selectedAmp = 10.0;
    private bool _armUnlocked;
    private string? _toast;
    private bool _confirmOpen;
    private CancellationTokenSource? _cts;
    private bool _pollBusy;

    private TaskInfo CurrentTask => Tasks.FirstOrDefault(t => t.Id == Ui.Task) ?? Tasks[0];
    private bool RealConnected => _status?.RealConnected ?? false;
    private bool PracticeActive => !RealConnected;
    private bool PreflightOk => PracticeActive || (_status?.Console?.Preflight?.Complete ?? false);

    private static bool IsArmBehaviour(string id) => id is "arm_raise" or "hand_wave";

    private void OnArmLockChanged()
    {
        if (!_armUnlocked && IsArmBehaviour(_selectedBehaviour))
        {
            _selectedBehaviour = "neck_turn";
        }
    }

    private IReadOnlyList<BehaviourInfoDto> Behaviours =>
        _status?.Behaviours is { Count: > 0 } b ? b : FallbackBehaviours;

    private bool IsIdle => _online && string.IsNullOrEmpty(_status?.Job);
    private bool IsJob(string name) => string.Equals(_status?.Job, name, StringComparison.OrdinalIgnoreCase);

    private string? BusyWhy => !_online ? "Waiting for the behaviour service."
        : !string.IsNullOrEmpty(_status?.Job) ? $"Busy: {_status!.Job} is running. Wait for it, or press E-STOP." : null;

    private bool PreviewMatched => _status?.Previewed is { } p
        && p.Behaviour == _selectedBehaviour
        && Math.Abs(p.Amplitude - _selectedAmp) < 0.01;

    private bool CheckMatched => _status?.Checked is { } c
        && c.Behaviour == _selectedBehaviour
        && Math.Abs(c.Amplitude - _selectedAmp) < 0.01
        && _status.CheckAgeS is >= 0 and < 300.0;

    // Practice runs never need the pre-flight checklist; the service decides the real-robot gate (can_run_robot).
    private bool CanRunRobot => IsIdle && PreviewMatched && CheckMatched && (PracticeActive || (_status?.CanRunRobot ?? false));

    private string RunLockedWhy => BusyWhy ?? (!PreviewMatched ? "step 1 is not done for this motion and size"
        : !CheckMatched ? "step 2 is not done (or older than 5 minutes)"
        : !PreflightOk ? "step 3, the pre-flight checklist, is open"
        : _status?.WhyNotRun ?? "not ready");

    private string ActiveDesc
    {
        get
        {
            var info = Behaviours.FirstOrDefault(b => b.Id == _selectedBehaviour) ?? Behaviours[0];
            return $"{info.Desc} ({Math.Min(_selectedAmp, info.MaxDeg):0}°)";
        }
    }

    private string LogText => _status?.Lines is { Count: > 0 } lines ? string.Join('\n', lines) : "Waiting for service output...";

    private TelemetryReadoutDto? VirtualPrimary =>
        _status?.Telemetry.GetValueOrDefault("virtual") ?? FromHead(_status?.Head.GetValueOrDefault("virtual"));

    private TelemetryReadoutDto? RealPrimary =>
        _status?.Telemetry.GetValueOrDefault("real")
        ?? (PracticeActive ? _status?.Telemetry.GetValueOrDefault("practice") : null)
        ?? FromHead(_status?.Head.GetValueOrDefault("real")
            ?? (PracticeActive ? _status?.Head.GetValueOrDefault("practice") : null));

    private static TelemetryReadoutDto? FromHead(HeadReadoutDto? h) => h is null ? null : new(
        h.T, h.Phase, null, null, "HEAD YAW", h.Yaw, h.Target, h.Other,
        null, null, null, null, null, null, null, null, h.Source, h.AgeS);

    private string VirtualStatusClass => IsJob("preview") ? "warn"
        : _status?.Results.GetValueOrDefault("preview") is { Ok: false } ? "bad"
        : PreviewMatched ? "ok" : string.Empty;

    private string VirtualStatusText => IsJob("preview") ? "Moving the twin…"
        : _status?.Results.GetValueOrDefault("preview") is { Ok: false } f ? $"Stopped: {f.Reason}"
        : PreviewMatched ? $"Done: {_selectedBehaviour.Replace('_', ' ')} ({_selectedAmp:0}°) ran cleanly on the twin."
        : "Runs on your PC only.";

    private string RealStatusClass => IsJob("check") || IsJob("run") || IsJob("snapshot") ? "warn"
        : IsJob("monitor") ? "ok"
        : _status?.Results.GetValueOrDefault("check") is { Ok: false } && !CheckMatched ? "bad"
        : _status?.Results.GetValueOrDefault("run") is { Ok: false } ? "bad"
        : CanRunRobot ? "ok" : string.Empty;

    private string RealStatusText => IsJob("snapshot") ? (PracticeActive ? "Reading the twin…" : "Reading the robot's joint angles (no motor power)…")
        : IsJob("check") ? (PracticeActive ? "Running the read-only check on the twin…" : "Running the read-only check on the robot (no motor power)…")
        : IsJob("monitor") ? $"Live view (no motor power): {_status?.MirrorSamples ?? 0} samples"
        : IsJob("run") ? (PracticeActive ? $"Twin moving: {_status?.MirrorSamples ?? 0} samples" : $"REAL ROBOT MOVING: {_status?.MirrorSamples ?? 0} samples mirrored")
        : _status?.Results.GetValueOrDefault("check") is { Ok: false } cf && !CheckMatched ? $"Check failed: {cf.Reason}"
        : _status?.Results.GetValueOrDefault("monitor") is { Ok: false } mf && (_status?.LastResult.StartsWith("monitor", StringComparison.Ordinal) ?? false) ? $"Live view failed: {mf.Reason}"
        : _status?.Results.GetValueOrDefault("run") is { Ok: false } rf ? $"Last run stopped: {rf.Reason}"
        : string.Empty;

    private RenderFragment EngineChooser => __builder =>
    {
        <div class="ctrl-row ops-row">
            <span class="ctrl-label">Twin engine</span>
            <RadzenButton class="@($"po-plain po-chip {(Ui.Engine == " builtin" ? "active" : string.Empty)}")" Click='() => Ui.SetEngineAsync("builtin")' title="Headless MuJoCo stand twin on this PC; shown in the 3D view">Built-in</RadzenButton>
            <RadzenButton class="@($"po-plain po-chip {(Ui.Engine == " unreal" ? "active" : string.Empty)}")" Click='() => Ui.SetEngineAsync("unreal")' title="The Unreal Engine twin (press Play in Unreal first)">Unreal</RadzenButton>
        </div>
    };

    private RenderFragment StepItem(int n, string title, bool done, bool running, string detail, (string Label, Func<Task> Act)? action, string? link = null) => __builder =>
    {
        <li class="step @(done ? "done" : running ? "running" : string.Empty)">
            <span class="step__n" aria-hidden="true">@(done ? "✓" : n.ToString())</span>
            <div class="step__body">
                <b>@title</b>
                <div class="po-muted">@(running ? "In progress…" : detail)</div>
            </div>
            @if (action is { } a && !running)
            {
                <RadzenButton class="@($"po-plain po-btn {(n == 4 && RealConnected ? " po-btn--orange" : "po-btn--blue-soft")}")" Click="a.Act">@a.Label</RadzenButton>
            }
            else if (link is not null && !done)
            {
                <a class="po-btn po-btn--blue-soft" href="@link">Open checklist</a>
            }
        </li>
    };

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        Ui.Changed += OnUiChanged;
        await Ui.InitAsync();
        await PollOnceAsync();
        _ = PollLoopAsync(_cts.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        // links from the Ask box: /?behaviour=neck_nod&amp=20 or /?joint=head_yaw_joint
        if (QueryBehaviour is { Length: > 0 } qb)
        {
            if (Ui.Task is null or "check" or "walk")
            {
                await Ui.SetTaskAsync("try");
            }
            ApplySuggestion((qb, QueryAmp));
            QueryBehaviour = null;
        }
        if (QueryJoint is { Length: > 0 } qj)
        {
            if (Ui.Task is null)
            {
                await Ui.SetTaskAsync("try");
            }
            _highlightJoint = qj;
            QueryJoint = null;
        }
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    private async Task ChooseAsync(string id)
    {
        if (id == "walk")
        {
            Nav.NavigateTo("/walk");
            return;
        }
        await Ui.SetTaskAsync(id);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(350));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await PollOnceAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // page closed
        }
    }

    private async Task PollOnceAsync()
    {
        if (_pollBusy)
        {
            return;
        }
        _pollBusy = true;
        try
        {
            _status = await Api.GetStatusAsync(_cts?.Token ?? CancellationToken.None);
            _online = _status is not null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _online = false;
        }
        finally
        {
            _pollBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectBehaviour(string id) => _selectedBehaviour = id;
    private void SelectAmplitude(double amp) => _selectedAmp = amp;

    private string? _highlightJoint;

    private double EffectiveAmplitude =>
        Math.Min(_selectedAmp, (Behaviours.FirstOrDefault(b => b.Id == _selectedBehaviour) ?? Behaviours[0]).MaxDeg);

    // Assistant suggestions only change the selection (same rules as clicking the chips); they never start a job.
    private void ApplySuggestion((string Behaviour, double? Amplitude) s)
    {
        if (!_online || !string.IsNullOrEmpty(_status?.Job) || (IsArmBehaviour(s.Behaviour) && !_armUnlocked))
        {
            _toast = IsArmBehaviour(s.Behaviour) && !_armUnlocked ? "Tick 'Unlock arm motions' to select an arm motion." : "Wait until the current job finishes.";
            return;
        }
        _selectedBehaviour = s.Behaviour;
        if (s.Amplitude is double a)
        {
            _selectedAmp = a;
        }
        _toast = $"Selected {s.Behaviour.Replace('_', ' ')} ({_selectedAmp:0}°). Run it on the twin next.";
    }

    private async Task ShowJointAsync(string joint)
    {
        _highlightJoint = joint;
        await JS.InvokeVoidAsync("poScrollIntoView", $"joint-{joint}");
    }

    private async Task PreviewAsync(string target)
    {
        var res = await Api.PreviewAsync(new PreviewRequest(_selectedBehaviour, _selectedAmp, 0.2, 20.0, target));
        _toast = res.Ok ? $"Running on the twin ({(target == "urlab" ? "Unreal" : "built-in")}). Nothing physical moves." : res.Error;
        await PollOnceAsync();
    }

    private async Task ProbeRealAsync()
    {
        var res = await Api.SnapshotAsync(practice: false);
        _toast = res.Ok ? "Looking for the real robot…" : res.Error;
        await PollOnceAsync();
    }

    private async Task CheckAsync()
    {
        var res = await Api.CheckAsync(new BehaviourParamsDto(_selectedBehaviour, _selectedAmp, 0.2, 20.0, Practice: PracticeActive));
        _toast = res.Ok ? (PracticeActive ? "Running the read-only check on the twin…" : "Reading the robot's sensors (no motor power)…") : res.Error;
        await PollOnceAsync();
    }

    private async Task SnapshotAsync()
    {
        var res = await Api.SnapshotAsync(practice: PracticeActive);
        _toast = res.Ok ? (PracticeActive ? "Read the twin's pose (no motor power)." : "Reading the robot's joint angles (no motor power)…") : res.Error;
        await PollOnceAsync();
    }

    private async Task MoveJointAsync(MoveJointRequest req)
    {
        var res = await Api.MoveJointAsync(req);
        _toast = res.Ok ? $"Moving {req.Joint} -> {req.TargetDeg:+0.0;-0.0;+0.0}° ({req.Target})…" : res.Error;
        await PollOnceAsync();
    }

    private async Task MonitorAsync()
    {
        var res = await Api.MonitorAsync(practice: PracticeActive);
        _toast = res.Ok ? (PracticeActive ? "Live view of the twin for 20 s." : "Live view of the robot for 30 s (no motor power).") : res.Error;
        await PollOnceAsync();
    }

    private Task OpenConfirm()
    {
        _confirmOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmRunAsync()
    {
        _confirmOpen = false;
        var res = await Api.RunAsync(new RunRequest(_selectedBehaviour, _selectedAmp, 0.2, 20.0, true, Practice: PracticeActive));
        _toast = res.Ok ? (PracticeActive ? "Running the practice step on the twin…" : "Starting the powered run on the REAL robot…") : res.Error;
        await PollOnceAsync();
    }

    private static RenderFragment RenderPrimaryGauge(TelemetryReadoutDto? tel, string accent, string emptyMsg) => __builder =>
    {
        if (tel?.ActualDeg is not double actual)
        {
            <div class="po-muted">@emptyMsg</div>
            return;
        }
        var toPct = (double d) => Math.Clamp((d + 30.0) / 60.0 * 100.0, 0.0, 100.0);
        <div class="gauge-row">
            <div>
                <b>@(tel.PrimaryLabel ?? "JOINT")</b> @($"{actual:+0.0;-0.0;+0.0}°")
                <div class="po-muted">
                    drift @($"{tel.OtherMaxDeg ?? 0:0.0}°") · @(tel.AgeS < 2 ? "live" : $"{tel.AgeS:0}s ago")
                </div>
            </div>
            <div class="gauge">
                <div class="gauge-zero"></div>
                @if (tel.TargetDeg is double tgt && tel.Source is not ("check" or "monitor"))
                {
                    <div class="gauge-target" style="left:@($"{toPct(tgt):0.#}%");background:@accent"></div>
                }
                <div class="gauge-actual" style="left:@($"{toPct(actual):0.#}%")"></div>
            </div>
        </div>
    };

    public void Dispose()
    {
        Ui.Changed -= OnUiChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
