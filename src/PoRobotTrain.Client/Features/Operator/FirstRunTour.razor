@implements IDisposable
@inject UiState Ui

@* Simplification #10: a dismissible four-step tour on the first visit (reopen it from Help). *@
@if (Ui.TourOpen)
{
    <div class="po-modal-bg" role="dialog" aria-modal="true" aria-labelledby="tour-title">
        <div class="po-modal tour">
            <div class="tour__step">Step @(_step + 1) of @Steps.Length</div>
            <h2 id="tour-title">@Steps[_step].Title</h2>
            <p>@Steps[_step].Body</p>
            <div class="tour__dots" aria-hidden="true">
                @for (var i = 0; i < Steps.Length; i++)
                {
                    <span class="@(i == _step ? "on" : string.Empty)"></span>
                }
            </div>
            <div class="btn-row">
                @if (_step > 0)
                {
                    <RadzenButton class="po-plain po-btn" Click="() => _step--">Back</RadzenButton>
                }
                @if (_step < Steps.Length - 1)
                {
                    <RadzenButton class="po-plain po-btn po-btn--blue" style="flex:1" Click="() => _step++">Next</RadzenButton>
                }
                else
                {
                    <RadzenButton class="po-plain po-btn po-btn--blue" style="flex:1" Click="FinishAsync">Start using the app</RadzenButton>
                }
                <RadzenButton class="po-plain po-chip" Click="FinishAsync">Skip</RadzenButton>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Title, string Body)[] Steps =
    [
        ("The virtual robot is a safe copy of the robot",
         "Everything you try first runs on the virtual robot, a simulated R1 on its stand. Nothing physical moves. The dot at the top says Virtual robot only until a real robot is connected."),
        ("Stopping",
         "The red E-STOP button (or the Esc key) stops everything this app is running. On the real robot, the remote is the emergency stop: hold L2 + B for 5 seconds. Keep it in your hand."),
        ("Moving the real robot takes four steps",
         "1 Play it on the virtual robot. 2 Check the robot (no motor power). 3 Tick the pre-flight checklist. 4 Confirm and run. Virtual | Real robot always shows one button: the next step."),
        ("Help and expert tools",
         "Help opens the guide for the page you are on. Tick Advanced for expert tools: joint sliders, the Ask box, Motions and Walk."),
    ];

    private int _step;

    protected override void OnInitialized() => Ui.Changed += OnChanged;

    private void OnChanged()
    {
        if (Ui.TourOpen && _step >= Steps.Length)
        {
            _step = 0;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task FinishAsync()
    {
        _step = 0;
        await Ui.FinishTourAsync();
    }

    public void Dispose() => Ui.Changed -= OnChanged;
}
